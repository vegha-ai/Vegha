<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460"
        x:Class="Vegha.App.Controls.Git.GitChoiceDialog"
        Title="Git"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource Bg1Brush}"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1" Content="Cancel" Click="OnCancel_Click"
                    Background="Transparent" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                    Foreground="{DynamicResource Text0Brush}" Padding="14,6" Margin="0,0,8,0" CornerRadius="4" />
            <Button Grid.Column="2" x:Name="OkButton" Content="OK" Click="OnOk_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Padding="18,6" CornerRadius="4" FontWeight="SemiBold" />
        </Grid>
        <StackPanel Spacing="10">
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text0Brush}" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" FontSize="11" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
            <ListBox x:Name="ChoiceList" MaxHeight="220" Background="{DynamicResource Bg2Brush}" />
            <SelectableTextBlock x:Name="DetailText" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 Foreground="{DynamicResource Text1Brush}" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
