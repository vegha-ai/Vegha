<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:git="using:Vegha.App.Controls.Git"
        xmlns:vm="using:Vegha.App.ViewModels.Git"
        mc:Ignorable="d" d:DesignWidth="560"
        x:Class="Vegha.App.Controls.Git.GitCredentialsDialog"
        x:DataType="vm:GitCredentialEditorViewModel"
        Title="Git credentials"
        Width="580"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource Bg1Brush}"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1" Content="Close" Click="OnClose_Click"
                    Background="Transparent" BorderBrush="{DynamicResource Border1Brush}" BorderThickness="1"
                    Foreground="{DynamicResource Text0Brush}" Padding="14,6" CornerRadius="4" />
        </Grid>
        <StackPanel Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding ProviderName, StringFormat='How should Vegha sign in to {0}?'}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text0Brush}" />
                <TextBlock Text="Credentials are matched to remotes by host (and optional path, e.g. one Azure DevOps organization). Anything not configured here uses your system Git setup."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text2Brush}" />
            </StackPanel>
            <git:GitCredentialEditorView />
        </StackPanel>
    </DockPanel>
</Window>
