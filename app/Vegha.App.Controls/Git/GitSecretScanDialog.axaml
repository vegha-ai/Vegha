<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:git="using:Vegha.Integrations.Git"
        mc:Ignorable="d" d:DesignWidth="600"
        x:Class="Vegha.App.Controls.Git.GitSecretScanDialog"
        Title="Possible secrets in this commit"
        Width="620"
        SizeToContent="Height"
        MaxHeight="640"
        CanResize="False"
        Background="{DynamicResource Bg1Brush}"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1" Content="Commit anyway" Click="OnCommit_Click"
                    Background="Transparent" BorderBrush="{DynamicResource StatusErrBrush}" BorderThickness="1"
                    Foreground="{DynamicResource StatusErrBrush}" Padding="14,6" Margin="0,0,8,0" CornerRadius="4" />
            <Button Grid.Column="2" Content="Cancel and review" Click="OnCancel_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Padding="18,6" CornerRadius="4" FontWeight="SemiBold" />
        </Grid>
        <StackPanel Spacing="10">
            <TextBlock Text="These staged lines look like credentials" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text0Brush}" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                       Text="Once pushed, a secret stays in Git history. Prefer environment variables marked as secret ({{token}}) — their values are stored encrypted in .secrets/, which is never committed — or a secret-manager reference (secret://…)." />
            <ScrollViewer MaxHeight="360">
                <ItemsControl x:Name="FindingsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="git:GitSecretFinding">
                            <Border Background="{DynamicResource Bg2Brush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Text1Brush}">
                                        <Run Text="{Binding Path}" FontWeight="SemiBold" />
                                        <Run Text=":" />
                                        <Run Text="{Binding Line}" />
                                        <Run Text="  ·  " Foreground="{DynamicResource Text3Brush}" />
                                        <Run Text="{Binding Kind}" Foreground="{DynamicResource StatusWarnBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding MaskedLine}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
