<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Vegha.App.ViewModels.Git"
             mc:Ignorable="d" d:DesignWidth="520"
             x:Class="Vegha.App.Controls.Git.GitCredentialEditorView"
             x:DataType="vm:GitCredentialEditorViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border1Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Text0Brush}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,12,*">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Classes="label" Text="HOST (OPTIONALLY WITH PATH)" />
                <TextBox Text="{Binding HostPattern}" Watermark="github.com  ·  dev.azure.com/contoso  ·  ghe.acme.com" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock Classes="label" Text="NAME" />
                <TextBox Text="{Binding DisplayName}" Watermark="Work GitHub" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="3">
            <TextBlock Classes="label" Text="SIGN-IN METHOD" />
            <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" HorizontalAlignment="Stretch" />
            <TextBlock Classes="hint" Text="{Binding MethodDescription}" />
        </StackPanel>

        <!-- PAT -->
        <StackPanel Spacing="8" IsVisible="{Binding IsPat}">
            <Grid ColumnDefinitions="*,12,2*">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Classes="label" Text="USERNAME (OPTIONAL)" />
                    <TextBox Text="{Binding Username}" Watermark="x-access-token" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Classes="label" Text="TOKEN" />
                    <TextBox Text="{Binding Secret}" PasswordChar="•" Watermark="Paste a personal access token" />
                </StackPanel>
            </Grid>
            <TextBlock Classes="hint" Text="A token is already saved for this profile — leave blank to keep it."
                       IsVisible="{Binding HasStoredSecret}" />
            <TextBlock Classes="hint" Text="{Binding PatHint}" IsVisible="{Binding PatHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Classes="link" Content="Create a token on the provider's website ↗" Command="{Binding OpenPatPageCommand}"
                    IsVisible="{Binding PatCreateUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Spacing="4">
                <RadioButton GroupName="patStore" Content="Store in Git Credential Manager (shared with terminal)"
                             IsChecked="{Binding StoreInVegha, Converter={x:Static BoolConverters.Not}}" />
                <RadioButton GroupName="patStore" Content="Store in Vegha only" IsChecked="{Binding StoreInVegha}" />
            </StackPanel>
        </StackPanel>

        <!-- SSH -->
        <StackPanel Spacing="6" IsVisible="{Binding IsSsh}">
            <TextBlock Classes="label" Text="PRIVATE KEY" />
            <Grid ColumnDefinitions="*,6,Auto">
                <TextBox Grid.Column="0" Text="{Binding SshKeyPath}" Watermark="~/.ssh/id_ed25519" />
                <Button Grid.Column="2" Classes="secondary" Content="Browse…" Click="OnBrowseKey_Click" />
            </Grid>
            <TextBlock Classes="hint" Text="Passphrase-protected keys must be loaded into ssh-agent (Windows: the OpenSSH Authentication Agent service; macOS: ssh-add --apple-use-keychain). Generate keys in Settings → Git → SSH keys." />
            <Button Classes="link" Content="Add your public key on the provider's website ↗" Command="{Binding OpenSshKeysPageCommand}"
                    IsVisible="{Binding SshAddKeyUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- gh -->
        <StackPanel Spacing="6" IsVisible="{Binding IsGh}">
            <StackPanel Spacing="3">
                <TextBlock Classes="label" Text="GITHUB ACCOUNT (WHEN SEVERAL ARE SIGNED IN)" />
                <TextBox Text="{Binding Username}" Watermark="Blank = gh's active account  ·  e.g. jdoe_acme" />
                <TextBlock Classes="hint" Text="Lets a work account and a personal account coexist: scope this profile to the org (github.com/acme) and name the gh login that has access." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary" Content="Sign in with GitHub CLI…" Command="{Binding GhLoginCommand}" IsEnabled="{Binding IsGhInstalled}" />
                <TextBlock Classes="hint" VerticalAlignment="Center" Text="GitHub CLI (gh) isn't installed — get it from cli.github.com."
                           IsVisible="{Binding !IsGhInstalled}" />
            </StackPanel>
            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="4" Padding="10,8"
                    IsVisible="{Binding DeviceCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="hint" Text="Enter this one-time code in the browser window:" />
                    <SelectableTextBlock Text="{Binding DeviceCode}" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Text0Brush}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- az -->
        <StackPanel Spacing="6" IsVisible="{Binding IsAz}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="secondary" Content="Sign in with Azure CLI…" Command="{Binding AzLoginCommand}" IsEnabled="{Binding IsAzInstalled}" />
                <TextBlock Classes="hint" VerticalAlignment="Center" Text="Azure CLI (az) isn't installed — see aka.ms/installazurecli."
                           IsVisible="{Binding !IsAzInstalled}" />
            </StackPanel>
        </StackPanel>

        <!-- test -->
        <StackPanel Spacing="3">
            <TextBlock Classes="label" Text="TEST AGAINST REPOSITORY URL" />
            <TextBox Text="{Binding TestUrl}" Watermark="https://github.com/acme/api-collections.git" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Classes="link" Content="Delete profile" Command="{Binding DeleteCommand}"
                    Foreground="{DynamicResource StatusErrBrush}" IsVisible="{Binding !IsNew}" />
            <Button Grid.Column="2" Classes="secondary" Content="Save &amp; test" Command="{Binding TestCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
        </Grid>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"
                   Classes.err="{Binding StatusIsError}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
                </Style>
                <Style Selector="TextBlock.err">
                    <Setter Property="Foreground" Value="{DynamicResource StatusErrBrush}" />
                </Style>
            </TextBlock.Styles>
        </TextBlock>
    </StackPanel>
</UserControl>
