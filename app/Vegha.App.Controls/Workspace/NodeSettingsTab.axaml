<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Vegha.App.ViewModels"
             xmlns:tabs="using:Vegha.App.ViewModels.Tabs"
             xmlns:ws="using:Vegha.App.Controls.Workspace"
             xmlns:icons="using:Vegha.App.Controls.Icons"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="Vegha.App.Controls.Workspace.NodeSettingsTab"
             x:DataType="tabs:NodeSettingsTabViewModel">
    <DockPanel Background="{DynamicResource Bg2Brush}">
        <!-- Header: collection name + Save -->
        <Border DockPanel.Dock="Top"
                Padding="16,12"
                BorderBrush="{DynamicResource Border0Brush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <icons:Icon Grid.Column="0" Kind="Collection" Size="18"
                            IsVisible="{Binding IsCollection}"
                            Foreground="{DynamicResource Text1Brush}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                <icons:Icon Grid.Column="0" Kind="Folder" Size="18"
                            IsVisible="{Binding !IsCollection}"
                            Foreground="{DynamicResource Text1Brush}"
                            VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Props.Name}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text0Brush}" />
                    <TextBlock Text="Collection settings"
                               IsVisible="{Binding IsCollection}"
                               FontSize="10" LetterSpacing="1"
                               Foreground="{DynamicResource Text2Brush}" />
                    <TextBlock Text="Folder settings"
                               IsVisible="{Binding !IsCollection}"
                               FontSize="10" LetterSpacing="1"
                               Foreground="{DynamicResource Text2Brush}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding Props.SaveCommand}"
                        Content="Save"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Padding="16,6" />
            </Grid>
        </Border>

        <TabControl Classes="subtabs" Padding="0" Background="{DynamicResource Bg2Brush}">
            <!-- ===================== Overview ===================== -->
            <TabItem Header="Overview">
                <Grid ColumnDefinitions="360,1,*" Margin="0">
                    <!-- ===== Left: info tiles ===== -->
                    <ScrollViewer Grid.Column="0">
                        <StackPanel Margin="20,18" Spacing="18">
                            <!-- Info tiles: [icon chip] label + value -->
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                                        Background="#1F3B82F6" VerticalAlignment="Top">
                                    <icons:Icon Kind="Folder" Size="18"
                                                Foreground="#60A5FA"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Location" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text0Brush}" />
                                    <SelectableTextBlock Text="{Binding Location}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{DynamicResource Text2Brush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsCollection}">
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                                        Background="#1F10B981" VerticalAlignment="Top">
                                    <icons:Icon Kind="Globe" Size="18"
                                                Foreground="#34D399"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Environments" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text0Brush}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                                        <Run Text="{Binding CollectionEnvCount}" />
                                        <Run Text=" collection · " />
                                        <Run Text="{Binding GlobalEnvCount}" />
                                        <Run Text=" global" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                                        Background="#1F7C3AED" VerticalAlignment="Top">
                                    <TextBlock Text="API" FontSize="11" FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="#A78BFA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Requests" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text0Brush}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Text2Brush}">
                                        <Run Text="{Binding RequestCount}" />
                                        <Run Text="{Binding RequestScopeLabel}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="{DynamicResource Border0Brush}" />

                    <!-- ===== Right: documentation (edit OR view, never both) ===== -->
                    <DockPanel Grid.Column="2">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,12,16,8">
                            <icons:Icon Grid.Column="0" Kind="FileText" Size="15"
                                        Foreground="{DynamicResource Text1Brush}"
                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="Documentation"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text0Brush}"
                                       VerticalAlignment="Center" />
                            <!-- Edit / done toggle: pencil while viewing, eye while editing. -->
                            <Button Grid.Column="2"
                                    Command="{Binding ToggleDocsEditCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Width="30" Height="28" Padding="0"
                                    Cursor="Hand">
                                <Panel>
                                    <icons:Icon Kind="Pencil" Size="15"
                                                Foreground="{DynamicResource Text2Brush}"
                                                IsVisible="{Binding !IsDocsEditing}"
                                                ToolTip.Tip="Edit documentation" />
                                    <icons:Icon Kind="Eye" Size="15"
                                                Foreground="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding IsDocsEditing}"
                                                ToolTip.Tip="Preview documentation" />
                                </Panel>
                            </Button>
                        </Grid>

                        <Panel>
                            <!-- EDIT mode: the Markdown editor (only). -->
                            <TextBox IsVisible="{Binding IsDocsEditing}"
                                     Text="{Binding Props.Docs}"
                                     AcceptsReturn="True"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Background="{DynamicResource CodeBgBrush}"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Text0Brush}"
                                     Padding="16,12"
                                     Watermark="{Binding DocsWatermark}" />

                            <!-- VIEW mode: rendered preview when docs exist, else a placeholder. -->
                            <Panel IsVisible="{Binding !IsDocsEditing}">
                                <ScrollViewer IsVisible="{Binding Props.Docs, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                              Padding="16,4">
                                    <ws:MarkdownView Markdown="{Binding Props.Docs}" />
                                </ScrollViewer>

                                <StackPanel IsVisible="{Binding Props.Docs, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Spacing="10" MaxWidth="360" Margin="0,0,0,40">
                                    <Border Width="48" Height="48" CornerRadius="24"
                                            Background="{DynamicResource Bg3Brush}"
                                            HorizontalAlignment="Center">
                                        <icons:Icon Kind="FileText" Size="22"
                                                    Foreground="{DynamicResource Text3Brush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No documentation yet"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text1Brush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DocsEmptyHint}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text2Brush}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <Button Content="Add documentation"
                                            Command="{Binding ToggleDocsEditCommand}"
                                            Classes="tertiary"
                                            HorizontalAlignment="Center"
                                            Margin="0,4,0,0" />
                                </StackPanel>
                            </Panel>
                        </Panel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===================== Headers ===================== -->
            <TabItem Header="Headers">
                <ws:KvEditor ItemsSource="{Binding Props.Headers}"
                             RemoveCommand="{Binding Props.RemoveHeaderCommand}"
                             Mode="headers" />
            </TabItem>

            <!-- ===================== Vars ===================== -->
            <TabItem Header="Vars">
                <ws:KvEditor ItemsSource="{Binding Props.Variables}"
                             RemoveCommand="{Binding Props.RemoveVariableCommand}" />
            </TabItem>

            <!-- ===================== Auth ===================== -->
            <!-- The same control the request editor hosts — per-type forms, OAuth2 token
                 panel and all. Nothing about auth is collection-specific. -->
            <TabItem Header="Auth">
                <ws:AuthEditor DataContext="{Binding Props.Auth}" />
            </TabItem>

            <!-- ===================== Script =====================
                 Same VariableAwareTextEditor the request tab uses — line numbers, JS syntax
                 highlighting, {{var}} awareness and bru.* completion, rather than the plain
                 TextBox this surface used to get. -->
            <TabItem Header="Script">
                <Grid Margin="16,12" RowDefinitions="Auto,*,12,Auto,*">
                    <TextBlock Grid.Row="0"
                               FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource Text3Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding PreRequestHint}"
                               Margin="0,0,0,6" />
                    <!-- Two stacked editors — each pane is short, so they get the compact
                         empty-state variant (no icon circle / shortcut chip). -->
                    <Grid Grid.Row="1">
                        <ws:VariableAwareTextEditor
                            Text="{Binding Props.PreRequestScript, Mode=TwoWay}"
                            Variables="{Binding Props.ResolvedVariablesSnapshot}"
                            SingleLine="False"
                            ShowLineNumbers="True"
                            SyntaxHighlightingName="JavaScript"
                            CompletionMode="Script"
                            ScriptKind="PreRequest" />
                        <StackPanel IsVisible="{Binding Props.PreRequestScript, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="6" MaxWidth="380">
                            <TextBlock Text="No pre-request script"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1Brush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PreRequestEmptyHint}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="3"
                               FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource Text3Brush}"
                               TextWrapping="Wrap"
                               Text="Post-response — runs after every response, before tests."
                               Margin="0,0,0,6" />
                    <Grid Grid.Row="4">
                        <ws:VariableAwareTextEditor
                            Text="{Binding Props.PostResponseScript, Mode=TwoWay}"
                            Variables="{Binding Props.ResolvedVariablesSnapshot}"
                            SingleLine="False"
                            ShowLineNumbers="True"
                            SyntaxHighlightingName="JavaScript"
                            CompletionMode="Script"
                            ScriptKind="PostResponse" />
                        <StackPanel IsVisible="{Binding Props.PostResponseScript, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="6" MaxWidth="380">
                            <TextBlock Text="No post-response script"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1Brush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PostResponseEmptyHint}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== Tests ===================== -->
            <TabItem Header="Tests">
                <DockPanel Margin="16,12">
                    <TextBlock DockPanel.Dock="Top"
                               FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource Text3Brush}"
                               TextWrapping="Wrap"
                               Text="{Binding TestsHint}"
                               Margin="0,0,0,6" />
                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding #NodeTestsEditor.HasError}"
                            Background="{DynamicResource Bg2Brush}"
                            BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0"
                            Padding="12,4">
                        <TextBlock Text="{Binding #NodeTestsEditor.ErrorSummary}"
                                   Foreground="{DynamicResource StatusErrBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                    <Grid>
                        <ws:VariableAwareTextEditor
                            x:Name="NodeTestsEditor"
                            Text="{Binding Props.TestsScript, Mode=TwoWay}"
                            Variables="{Binding Props.ResolvedVariablesSnapshot}"
                            SingleLine="False"
                            ShowLineNumbers="True"
                            SyntaxHighlightingName="JavaScript"
                            CompletionMode="Script"
                            ScriptKind="Tests" />
                        <StackPanel IsVisible="{Binding Props.TestsScript, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="12" MaxWidth="380">
                            <Border Width="52" Height="52" CornerRadius="26"
                                    Background="{DynamicResource Bg3Brush}"
                                    HorizontalAlignment="Center">
                                <icons:Icon Kind="Play" Size="22"
                                            Foreground="{DynamicResource Text3Brush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No tests yet"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1Brush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TestsEmptyHint}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text2Brush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <Border Background="{DynamicResource Bg3Brush}"
                                    BorderBrush="{DynamicResource Border1Brush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="10,4" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Ctrl + Space"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text1Brush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Autocomplete"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text2Brush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Presets are new-request defaults for a collection; folders have none. -->
            <TabItem Header="Presets" IsVisible="{Binding IsCollection}">
                <ScrollViewer>
                    <StackPanel Margin="16,12" Spacing="14" MaxWidth="480" HorizontalAlignment="Left">
                        <TextBlock Text="Defaults applied when creating a new request in this collection."
                                   FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Request type" FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <ComboBox SelectedItem="{Binding Props.PresetRequestType}"
                                      ItemsSource="{Binding Props.AvailablePresetTypes}"
                                      Width="200"
                                      Background="{DynamicResource Bg3Brush}"
                                      BorderBrush="{DynamicResource Border1Brush}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Base URL" FontSize="11"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <TextBox Text="{Binding Props.PresetBaseUrl}"
                                     Watermark="https://api.example.com"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     Background="{DynamicResource BgInputBrush}"
                                     BorderBrush="{DynamicResource Border1Brush}"
                                     Foreground="{DynamicResource Text0Brush}"
                                     Padding="6,4" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
