<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        xmlns:icons="using:Vegha.App.Controls.Icons"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="460"
        x:Class="Vegha.App.Controls.Workspace.EnvironmentEditDialog"
        Title="Edit environment"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource Bg1Brush}"
        FontSize="{DynamicResource AppFontSize}"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
            <Button Grid.Column="1" Content="Cancel" Click="OnCancel_Click"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Border1Brush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource Text0Brush}"
                    Padding="14,6" Margin="0,0,8,0"
                    CornerRadius="4" />
            <Button Grid.Column="2" Content="Save" Click="OnOk_Click"
                    IsDefault="True"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="18,6"
                    CornerRadius="4"
                    FontWeight="SemiBold" />
        </Grid>

        <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Name" />
            <TextBox x:Name="NameBox"
                     FontSize="13"
                     Background="{DynamicResource BgInputBrush}"
                     BorderBrush="{DynamicResource Border1Brush}"
                     Foreground="{DynamicResource Text0Brush}"
                     Padding="8,6" />

            <TextBlock Classes="label" Text="Color" Margin="0,8,0,0" />
            <!-- Spectrum + hue slider reach any shade; the right column holds quick-pick
                 presets, a shuffle, the exact hex value and a live preview of the pill. -->
            <Grid ColumnDefinitions="160,*">
                <primitives:ColorSpectrum x:Name="Spectrum"
                                          Grid.Column="0"
                                          Components="SaturationValue"
                                          Shape="Box"
                                          Width="160" Height="160"
                                          CornerRadius="6" />
                <DockPanel Grid.Column="1" Margin="16,0,0,0">
                    <Border x:Name="PreviewChip"
                            DockPanel.Dock="Bottom"
                            HorizontalAlignment="Left"
                            CornerRadius="11"
                            Padding="10,3">
                        <TextBlock x:Name="PreviewText"
                                   Foreground="White"
                                   FontSize="12" FontWeight="SemiBold"
                                   MaxWidth="160"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="hint" Text="Presets" />
                        <WrapPanel x:Name="SwatchPanel">
                            <!-- Swatches are inserted ahead of the shuffle button in code. -->
                            <Button x:Name="ShuffleBtn"
                                    Classes="swatch"
                                    Click="OnShuffle_Click"
                                    ToolTip.Tip="Random color"
                                    Background="{DynamicResource Bg2Brush}"
                                    Foreground="{DynamicResource Text1Brush}">
                                <icons:Icon Kind="Refresh" Size="12" />
                            </Button>
                        </WrapPanel>
                        <TextBlock Classes="hint" Text="Hex" Margin="0,2,0,0" />
                        <TextBox x:Name="HexBox"
                                 FontFamily="{DynamicResource MonoFont}"
                                 FontSize="12"
                                 Watermark="#RRGGBB"
                                 MaxLength="7"
                                 Background="{DynamicResource BgInputBrush}"
                                 BorderBrush="{DynamicResource Border1Brush}"
                                 Foreground="{DynamicResource Text0Brush}"
                                 Padding="8,5" />
                    </StackPanel>
                </DockPanel>
            </Grid>
            <primitives:ColorSlider x:Name="HueSlider"
                                    ColorModel="Hsva"
                                    ColorComponent="Component1"
                                    IsAlphaVisible="False"
                                    Orientation="Horizontal"
                                    Height="18"
                                    Margin="0,4,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
