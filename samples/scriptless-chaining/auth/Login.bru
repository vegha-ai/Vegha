meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}",
    "expiresInMins": 30
  }
}

vars:post-response {
  token: res.body.accessToken
  userId: res.body.id
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
  res.body.email: isEmail
}
